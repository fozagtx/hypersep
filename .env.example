# Optional server-side RPC overrides used by the quote engine and relayer.
PORTALDOT_RPC=https://test-evm-rpc-v3.portaldot.dev
SEPOLIA_RPC=https://rpc.sepolia.org

# Optional client-side RPC overrides used by the wallet layer.
NEXT_PUBLIC_PORTALDOT_RPC=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_SEPOLIA_RPC=https://rpc.sepolia.org

# Testnet-only relayer key for POST /api/bridge/relay.
# Must match the bridge's configured relayer address. Never use a mainnet key.
RELAYER_PRIVATE_KEY=
