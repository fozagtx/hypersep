# Testnet relayer key used by /api/bridge/relay.
# Must match the relayer address configured on PortalXBridge (deploy-time).
# TESTNET ONLY — never use a mainnet key.
RELAYER_PRIVATE_KEY=

# Optional RPC overrides (server-side)
PORTALDOT_RPC=https://test-evm-rpc-v3.portaldot.dev
SEPOLIA_RPC=https://rpc.sepolia.org

# Optional RPC overrides (client-side)
NEXT_PUBLIC_PORTALDOT_RPC=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_SEPOLIA_RPC=https://rpc.sepolia.org
